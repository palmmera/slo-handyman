# SLO Handyman — Environment Variables
# Copy this to .env and fill in your values.

# --- Stripe (use LIVE keys for production) ---
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# --- Marketplace settings ---
BOOKING_FEE=5
COMMISSION_PERCENT=12

# --- App ---
BASE_URL=https://slohandyman.com
ADMIN_TOKEN=pick_a_strong_secret_password
PORT=3000

# --- Social sign-in (optional) ---
# Leave blank to hide the Google/Apple buttons.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- Email (powers contact form + handyman notifications) ---
# Two providers are supported. Resend is tried first; SMTP is the fallback.

# Option 1 (recommended): Resend. Get a key at https://resend.com and verify
# your domain, then set the key below. MAIL_FROM must be on that domain.
RESEND_API_KEY=
# Friendly "from" address shown to recipients. For Resend this MUST be an
# address on a domain you've verified in Resend.
MAIL_FROM=SLO Handyman <notifications@slohandyman.com>

# Where contact-form messages are delivered.
CONTACT_EMAIL=slohandyman@smart-folder.com

# Option 2 (fallback): SMTP via your existing mailbox. Used only if
# RESEND_API_KEY is blank (or Resend errors). Leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
